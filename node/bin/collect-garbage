#!/bin/bash
# Collect the database's garbage: brainfreeze-gc.service, daily.
#
# What GemDB Code schedules under the editor, which a server does not run:
# a mark-for-collection, then the space comes back in the background. Without
# it, every abandoned quote and replaced object stays in the extent until it
# reaches the free license's 10 GB. Also clears statistics files older than
# two weeks, as GemDB Code would.

set -euo pipefail
set -a
# shellcheck source=/dev/null
. /etc/brainfreeze/node.env
set +a

# As DataCurator: the `gemdb` account lacks GarbageCollection
# (bin/as-datacurator). Judged by the collector's report, since topaz's exit
# status says nothing. On 4.0 markForCollection answers the report as a
# Warning, older engines signal it; either way its text is printed. The
# free-space notice (2338) is resumed past rather than ending the mark.
# (GemDB Code's MFC_QUERY, src/maintenance.ts.)
said="$("$DEPLOY/node/bin/as-datacurator" '[| r | r := [SystemRepository markForCollection] on: Warning do: [:w | w messageText]. (r isKindOf: Exception) ifTrue: [r messageText asString] ifFalse: [r asString]] on: Error do: [:e | e number = 2338 ifTrue: [e resume: nil] ifFalse: [e pass]]' 2>&1)" || true
echo "$said"
grep -q "markForCollection found" <<<"$said"
find "$ROOT/db/stat" -type f -mtime +14 -delete 2>/dev/null || true
